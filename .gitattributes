* text=auto
.gitattributes text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.md text eol=lf
# 入口脚本没有扩展名，单独固定 LF，避免 Windows 检出后把 CRLF 打进 tar.gz
java-systemd-service-as-code/src/main/scripts/* text eol=lf
# 生成的模板固定 LF，保证 Windows 构建出的 jar 在 Linux 上生成的 xac.yaml 逐字节一致
java-systemd-service-as-code/src/main/resources/xac.yaml.template text eol=lf
