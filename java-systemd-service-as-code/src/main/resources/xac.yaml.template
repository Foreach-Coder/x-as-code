# xac.yaml -- service definition for java-systemd-service-as-code.
#
# This file is the single source of truth for one service. `apply` validates it,
# renders /etc/systemd/system/xac.<name>.service and /etc/xac/xac.<name>.env,
# then reloads systemd, enables and restarts the unit.
#
# The schema is strict: unknown keys are errors.

name: {{name}}
description: {{name}} service

artifact:
  # Application jar, relative to this package directory or absolute.
  jar: {{jar}}

runtime:
  # Java executable used to start the service.
  java: {{java}}
  # JVM arguments, one list item per argument, passed verbatim, for example:
  # opts:
  #   - -Xmx512m
  #   - -XX:+UseG1GC

# Environment variables, written to /etc/xac/xac.{{name}}.env with mode 0600.
# Values are literal; ${VAR} inside opts/properties is expanded by systemd when
# the service starts, not when the unit is rendered.
# env:
#   GREETING: hello world

# System properties, rendered as -Dkey=value after opts (so they win).
# properties:
#   server.port: "8080"

# Working directory; defaults to this package directory when omitted.
# workdir: /opt/{{name}}/work

# Symlinks created before the service starts: "source:target", target absolute.
# If a target already exists and is not a symlink to the source, apply refuses
# to run and changes nothing; fix it by hand.
# path-links:
#   - ./conf:/opt/{{name}}/conf

# Where `logs` reads from. Omit this section to read journald
# (journalctl -u xac.<name>); set `file` to read that file instead, for services
# that write their own log file rather than stdout. The path must be absolute;
# the CLI never creates or rotates the file.
# logs:
#   file: /var/log/{{name}}/app.log

lifecycle:
  # false keeps the service from starting at boot.
  auto-start: true
  restart: on-failure
  restart-sec: 5
  timeout-stop-sec: 60
